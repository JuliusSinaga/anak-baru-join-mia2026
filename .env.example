# URL publik situs (dipakai untuk metadata, sitemap, robots).
# Di Vercel boleh dikosongkan; VERCEL_PROJECT_PRODUCTION_URL dipakai otomatis.
NEXT_PUBLIC_SITE_URL=

# Laporan warga (opsional). Tanpa dua variabel ini, bagian laporan tidak ditampilkan dan /api/laporan menjawab 503.
# SERVICE_ROLE_KEY melewati RLS: hanya untuk server (Vercel env), jangan diberi awalan NEXT_PUBLIC_ dan jangan di-commit.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
